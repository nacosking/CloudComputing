// Testimonials Section
const TestimonialsSection = () => {
  const [api, setApi] = useState<CarouselApi>();
  const [current, setCurrent] = useState(0);

  const testimonials: Testimonial[] = [
    {
      text: "The best coffee experience in town! The atmosphere is cozy and the staff is incredibly friendly. I come here every morning.",
      name: "Sarah Johnson",
      role: "Regular Customer",
      image: "https://randomuser.me/api/portraits/women/1.jpg",
    },
    {
      text: "Perfect spot for meetings and work. Great coffee, reliable WiFi, and a peaceful environment. Highly recommend!",
      name: "Michael Chen",
      role: "Entrepreneur",
      image: "https://randomuser.me/api/portraits/men/2.jpg",
    },
    {
      text: "Their pour-over coffee is exceptional. You can taste the quality in every sip. The booking system makes it easy to secure a table.",
      name: "Emma Davis",
      role: "Coffee Enthusiast",
      image: "https://randomuser.me/api/portraits/women/3.jpg",
    },
    {
      text: "A hidden gem! The ambiance is perfect for relaxing or catching up with friends. The pastries are amazing too!",
      name: "James Wilson",
      role: "Food Blogger",
      image: "https://randomuser.me/api/portraits/men/4.jpg",
    },
  ];

  useEffect(() => {
    if (!api) return;

    const interval = setInterval(() => {
      if (api.selectedScrollSnap() + 1 === api.scrollSnapList().length) {
        setCurrent(0);
        api.scrollTo(0);
      } else {
        api.scrollNext();
        setCurrent(current + 1);
      }
    }, 4000);

    return () => clearInterval(interval);
  }, [api, current]);

  return (
    <section className="py-20 bg-white">
      <div className="mx-auto max-w-7xl px-6">
        <div className="text-center mb-16">
          <h2 className="text-4xl font-bold text-[#5D4037] mb-4">
            What Our Customers Say
          </h2>
          <p className="text-[#6D4C41] max-w-2xl mx-auto">
            Hear from our valued customers about their experiences.
          </p>
        </div>
        <Carousel setApi={setApi} className="w-full">
          <CarouselContent>
            {testimonials.map((testimonial, index) => (
              <CarouselItem className="lg:basis-1/2" key={index}>
                <div className="bg-gradient-to-br from-[#FFF8F0] to-[#FFEFD5] rounded-2xl h-full p-8 shadow-lg border border-[#D4A574]/20">
                  <Star className="w-8 h-8 text-[#8B4513] mb-4" />
                  <p className="text-[#6D4C41] mb-6 leading-relaxed">
                    "{testimonial.text}"
                  </p>
                  <div className="flex items-center gap-3">
                    <Avatar className="h-12 w-12">
                      <AvatarImage src={testimonial.image} />
                      <AvatarFallback className="bg-[#8B4513] text-white">
                        {testimonial.name.charAt(0)}
                      </AvatarFallback>
                    </Avatar>
                    <div>
                      <div className="font-semibold text-[#5D4037]">
                        {testimonial.name}
                      </div>
                      <div className="text-sm text-[#6D4C41]">
                        {testimonial.role}
                      </div>
                    </div>
                  </div>
                </div>
              </CarouselItem>
            ))}
          </CarouselContent>
        </Carousel>
      </div>
    </section>
  );
};

